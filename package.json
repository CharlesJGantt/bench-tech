{
  "name": "bench-tech",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "models": "node tools/build-models.mjs",
    "routes": "vitest run -c tools/vitest.routes.config.ts --reporter=verbose && node -e \"require('fs').rmSync('node_modules/.vitest-cache',{recursive:true,force:true})\"",
    "voice": "python tools/generate-voice.py && node tools/encode-voice.mjs"
  },
  "dependencies": {
    "playcanvas": "^2.23.2"
  },
  "devDependencies": {
    "lamejs": "^1.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
